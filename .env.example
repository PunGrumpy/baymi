# Copy to .env and fill in every value. All variables are declared and validated in
# agent/lib/env.ts; none has a fallback, so a missing or malformed value fails discovery.
# The telemetry block at the end is the exception: those are optional, and the agent
# runs without them.

# --- Model access (Anthropic wire protocol) ---
# The agent speaks the Anthropic protocol, but ANTHROPIC_BASE_URL decides which
# service answers: Anthropic's own API, or any compatible gateway. The base URL
# must include the /v1 suffix when the endpoint expects it, since the AI SDK
# appends /messages to it. The key is whatever token that endpoint issues, so it
# is not required to look like an `sk-` key. The model id is set in
# agent/agent.ts, not here.
ANTHROPIC_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"

# --- Vercel Connect connector UIDs ---
# GitHub App connector; shared by the GitHub channel and the GitHub tools extension.
GITHUB_CONNECTOR="github/baymi"
# Linear connector; shared by the Linear channel and the Linear MCP connection.
LINEAR_CONNECTOR="linear/baymi"
# Slack connector; supplies the bot token and verifies inbound webhooks. The send_slack_dm
# tool needs Bot Scopes chat:write, im:write, and users:read.email on this connector.
SLACK_CONNECTOR="slack/baymi"

# --- Weekly digest schedule ---
# Repositories whose open issues are digested, as owner/repo, comma separated.
# Each one gets its own digest in its own Slack thread, so an issue number in a
# thread reply resolves against exactly one repository.
DIGEST_REPOS="owner/repo,owner/other-repo"
# Slack conversation ID the digest is posted to (Channel details -> copy the C... ID).
# The bot must be a member of the channel, and thread replies need message.channels +
# channels:history on the connector.
DIGEST_SLACK_CHANNEL="C0123456789"

# --- Model selection ---
# Model ids as the endpoint above names them. Two variables, not one, so an eval
# run can be graded by a model other than the one under test: pointing both at
# the same id makes every judged score a self-assessment. Both are required and
# neither has a default, and an empty value counts as unset, so give each a real
# id rather than leaving the quotes empty.
MODEL=""
EVAL_MODEL=""

# --- Telemetry (optional) ---
# agent/hooks/evlog.ts writes one evlog wide event per turn: who called, on which
# channel, how many tokens, which tools ran, how it ended. Never the message content.
# Without any of this the events are still recorded and printed by `eve dev`; what is
# missing is a destination and the weekly cost report.
#
# PostHog project API key (Project settings -> Project API key, starts with phc_).
# Set it and every turn is sent as a `baymi_turn` custom event, and every `bun run eval`
# result as a `baymi_eval` one. Leave it empty and both still run, with nowhere to report.
POSTHOG_API_KEY=""
# Ingestion host, only when the project is not on US cloud: https://eu.i.posthog.com.
# This is the capture endpoint (us.i.posthog.com), not POSTHOG_API_HOST below, which is
# where queries are read back from. Both the turn drain and the eval reporter post here.
POSTHOG_HOST=""
# Personal API key (Personal settings -> Personal API keys, starts with phx_) with the
# "Query: Read" scope and nothing else, scoped to this one project. This is the read
# side: it is what gives a session the `usage_report` tool the cost-watchdog needs.
POSTHOG_PERSONAL_API_KEY=""
# The numeric project id that key reads (Project settings -> Project ID). Required
# alongside the key: PostHog asks for the id rather than an alias, and a key scoped to
# one project has no user session for "@current" to resolve from. Without both, the
# session simply carries no usage_report tool.
POSTHOG_PROJECT_ID=""
# API host for those queries, only when the project is not on US cloud:
# https://eu.posthog.com. Defaults to https://us.posthog.com.
POSTHOG_API_HOST=""
# What a token costs, as <input>,<output> in dollars per million tokens, e.g. "1.4,4.4".
# Take it from the model's OpenRouter listing. The gateway reports no price of its own,
# so this is the only way a turn carries one, and it is a list price rather than an
# invoice: the endpoint you point at may charge something else, and a cached input token
# bills lower than the rate here. Leave it empty and the weekly report counts tokens and
# turns and says the dollar column is unavailable, which is better than a guessed price.
MODEL_COST_PER_MTOK=""
# The OpenRouter slug that price came from, e.g. "z-ai/glm-5.3". A gateway often renames
# a model, so this is a separate variable from MODEL. Set it and the weekly report reads
# https://openrouter.ai/api/v1/models/<slug>/endpoints on every run and says when the
# published rate no longer matches the one above. Leave it empty and the report still
# runs, with the price marked unconfirmed.
OPENROUTER_MODEL_SLUG=""
