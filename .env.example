# Copy to .env and fill in every value. All variables are declared and validated in
# agent/lib/env.ts; none has a fallback, so a missing or malformed value fails discovery.

# --- Model access (Anthropic wire protocol) ---
# The agent speaks the Anthropic protocol, but ANTHROPIC_BASE_URL decides which
# service answers: Anthropic's own API, or any compatible gateway. The base URL
# must include the /v1 suffix when the endpoint expects it, since the AI SDK
# appends /messages to it. The key is whatever token that endpoint issues, so it
# is not required to look like an `sk-` key. The model id is set in
# agent/agent.ts, not here.
ANTHROPIC_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"

# --- Vercel Connect connector UIDs ---
# GitHub App connector; shared by the GitHub channel and the GitHub tools extension.
GITHUB_CONNECTOR="github/baymi"
# Linear connector; shared by the Linear channel and the Linear MCP connection.
LINEAR_CONNECTOR="linear/baymi"
# Slack connector; supplies the bot token and verifies inbound webhooks. The send_slack_dm
# tool needs Bot Scopes chat:write, im:write, and users:read.email on this connector.
SLACK_CONNECTOR="slack/baymi"

# --- Weekly digest schedule ---
# Repositories whose open issues are digested, as owner/repo, comma separated.
# Each one gets its own digest in its own Slack thread, so an issue number in a
# thread reply resolves against exactly one repository.
DIGEST_REPOS="owner/repo,owner/other-repo"
# Slack conversation ID the digest is posted to (Channel details -> copy the C... ID).
# The bot must be a member of the channel, and thread replies need message.channels +
# channels:history on the connector.
DIGEST_SLACK_CHANNEL="C0123456789"

# --- Model selection ---
# Model ids as the endpoint above names them. Two variables, not one, so an eval
# run can be graded by a model other than the one under test: pointing both at
# the same id makes every judged score a self-assessment. Both are required and
# neither has a default, and an empty value counts as unset, so give each a real
# id rather than leaving the quotes empty.
MODEL=""
EVAL_MODEL=""
