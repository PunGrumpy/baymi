# Copy to .env and fill in every value. agent/lib/env.ts validates all of them
# at boot, with no fallbacks, so a missing or malformed value fails discovery.
# The optional block at the end can stay empty.

# Model access
# The agent speaks the Anthropic wire protocol. ANTHROPIC_BASE_URL decides who
# answers: Anthropic's own API, or any compatible gateway. Include the /v1
# suffix when the endpoint expects it. The key is whatever token that endpoint
# issues. A security review is one long careful read, so pick a model that
# reasons well over a large diff and calls tools reliably.
ANTHROPIC_API_KEY="your_api_key_here"
ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"
MODEL="your_model_id"
# Grades eval runs. Keep it different from MODEL, or every judged score is a
# self-assessment.
EVAL_MODEL="your_grader_model_id"

# GitHub
# The GitHub App connector on Vercel Connect. It supplies the installation
# token only: the App posts its webhooks straight at /eve/v1/github, not
# through Connect's metered trigger forwarder, so turn that trigger off.
GITHUB_CONNECTOR="github/baymi"
# The App's webhook secret (App settings > Webhook > Secret). Set the Webhook
# URL to https://your_deployment.vercel.app/eve/v1/github and subscribe to
# pull_request, issue_comment, and pull_request_review_comment. Permissions:
# Contents read, Metadata read, Issues read and write, Pull requests read and
# write. Which repositories the agent watches is decided by where you install
# the App, and nowhere else.
GITHUB_WEBHOOK_SECRET="your_webhook_secret_here"

# Slack
# The Slack connector. Bot scopes: chat:write, plus im:write when the check-in
# target below is a member. Thread follow-ups without a mention need
# message.channels under trigger event types and channels:history under bot
# scopes (message.groups and groups:history for private channels).
SLACK_CONNECTOR="slack/baymi"

# Optional
# Where the agent checks in on its own: a channel ID (starts with C) the bot is a
# member of, or your member ID (starts with U), which opens a DM. It posts there when a review
# finds something critical or high, and when a review could not finish. Leave
# it empty and the agent still reviews and answers, but never posts on its own.
SLACK_NOTIFY_CHANNEL=""
# Your workspace's team ID (starts with T). Set it to admit only humans of that
# workspace; without it any human the connector delivers is admitted, which
# includes Slack Connect guests from other workspaces.
SLACK_TEAM_ID=""
# PostHog project API key (starts with phc_). Sends one baymi_turn event per
# turn: caller, channel, tokens, tools, outcome. Never message content. Without
# it the events still print in `eve dev`.
POSTHOG_API_KEY=""
# Capture host, only when the project is not on US cloud: https://eu.i.posthog.com
POSTHOG_HOST=""
