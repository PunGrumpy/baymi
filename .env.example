# Copy to .env and fill in every value. agent/lib/env.ts validates all of them at
# boot, with no fallbacks, so a missing or malformed value fails discovery. The
# telemetry block at the end is optional.

# Model access
# The agent speaks the Anthropic wire protocol. ANTHROPIC_BASE_URL decides who
# answers: Anthropic's own API, or any compatible gateway. Include the /v1 suffix
# when the endpoint expects it, because the AI SDK appends /messages. The key is
# whatever token that endpoint issues.
ANTHROPIC_API_KEY="your_api_key_here"
ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"

# Model selection
# Model ids as the endpoint above names them. EVAL_MODEL grades eval runs, so keep
# it different from MODEL, or every judged score is a self-assessment. An empty
# value counts as unset.
MODEL="your_model_id"
EVAL_MODEL="your_grader_model_id"

# Vercel Connect connectors
# GitHub App connector, shared by the GitHub channel and the GitHub tools
# extension. It supplies the installation token only. The App posts its webhooks
# straight at /eve/v1/github, not through Connect's metered trigger forwarder, so
# turn that trigger off in Connect.
GITHUB_CONNECTOR="github/baymi"
# The GitHub App's webhook secret (App settings > Webhook > Secret). Set the App's
# Webhook URL to https://your_deployment.vercel.app/eve/v1/github and subscribe to
# issue_comment and issues only. A preview deployment behind Deployment Protection
# cannot receive these; see docs/notes.md.
GITHUB_WEBHOOK_SECRET="your_webhook_secret_here"
# Linear connector, shared by the Linear channel and the Linear MCP connection.
LINEAR_CONNECTOR="linear/baymi"
# Slack connector. The send_slack_dm tool needs the chat:write, im:write and
# users:read.email bot scopes on it.
SLACK_CONNECTOR="slack/baymi"

# Weekly digest
# Repositories to digest, as owner/repo, comma separated. Each gets its own Slack
# thread, so an issue number in a reply resolves against one repository.
DIGEST_REPOS="owner/repo,owner/other-repo"
# Slack conversation ID the digest posts to (Channel details > copy the ID). The
# bot must be a member, and thread replies need message.channels and
# channels:history on the connector.
DIGEST_SLACK_CHANNEL="C0123456789"

# Telemetry (optional)
# agent/hooks/evlog.ts records one event per turn: caller, channel, tokens, tools,
# outcome. Never message content. Without these the events still print in
# `eve dev`; what is missing is a destination and the weekly usage report.
#
# Project API key (Project settings > Project API key, starts with phc_). Sends
# every turn as a baymi_turn event, every eval result as baymi_eval, and every
# model call as an $ai_generation span. The spans carry no prompt or completion.
POSTHOG_API_KEY=""
# Capture host, only when the project is not on US cloud: https://eu.i.posthog.com
POSTHOG_HOST=""
# Personal API key (Personal settings > Personal API keys, starts with phx_) with
# the Query: Read scope only, scoped to this project. It is what gives a session
# the usage_report tool.
POSTHOG_PERSONAL_API_KEY=""
# Numeric project id that key reads (Project settings > Project ID). Required with
# the key: a project-scoped key has no user session for @current to resolve from.
POSTHOG_PROJECT_ID=""
# Query host, only when the project is not on US cloud: https://eu.posthog.com
POSTHOG_API_HOST=""
